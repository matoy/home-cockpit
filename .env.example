# ==============================================================================
# Home Cockpit — Configuration des variables d'environnement
# ==============================================================================

# Base de données Neon Postgres
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Sécurité de l'application
APP_PASSWORD="votre-mot-de-passe-dashboard"
SCHEDULE_SECRET="secret-long-aleatoire-pour-cron-job-org"
# AUTH_SESSION_SECRET="" # Recommandé si APP_PASSWORD est désactivé (mode OIDC seul)

# URL publique de l'application (recommandé en production pour générer les URI de callback OAuth / OIDC)
NEXT_PUBLIC_APP_URL="http://localhost:3000" # En production : https://votre-app.vercel.app (sans slash final)

# Authentification par IdP / OIDC (optionnel — ex. Google, Authentik, Keycloak)
# AUTH_OIDC_ISSUER="https://accounts.google.com"
# AUTH_OIDC_CLIENT_ID="votre-client-oidc.apps.googleusercontent.com"
# AUTH_OIDC_CLIENT_SECRET="GOCSPX-votre-secret-oidc"
# AUTH_OIDC_PROVIDER_NAME="Google"
# AUTH_ALLOWED_EMAILS="alice@gmail.com,bob@gmail.com"
# AUTH_ALLOWED_DOMAINS="" # ex. mon-domaine.com
# AUTH_ALLOW_ANY_AUTHENTICATED="false" # Mettre "true" uniquement pour un IdP privé sans liste blanche

# Configuration Tuya IoT Cloud Platform
TUYA_ACCESS_ID="votre_access_id_tuya"
TUYA_ACCESS_SECRET="votre_access_secret_tuya"
TUYA_REGION="eu" # eu (Central Europe), weu (Western Europe), us, eus, cn, in
TUYA_USER_UID="votre_uid_compte_app_smart_life"

# Configuration Google Home (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_HOME_MODE="off" # "off" (masqué), "mcp" (Home MCP) ou "sdm" (Nest SDM API)
GOOGLE_SDM_PROJECT_ID="" # Requis uniquement si GOOGLE_HOME_MODE="sdm"
TOKEN_ENCRYPTION_KEY="" # Optionnel : clé dédiée de chiffrement des tokens OAuth en BDD

# Configuration TP-Link Kasa Cloud (100% cloud, lecture seule — optionnel)
KASA_EMAIL=""
KASA_PASSWORD=""
KASA_REGION="eu" # eu (Europe), us (US), ap (Asia-Pacific), global
KASA_CLOUD_URL="" # Optionnel : surcharge explicite (ex. https://eu-wap.tplinkcloud.com)
KASA_TERMINAL_UUID="" # Optionnel : UUID fixe (sinon dérivé automatiquement de KASA_EMAIL)

# Configuration Siemens Home Connect Cloud (OAuth 2.0, 100% lecture seule — optionnel)
SIEMENS_HOME_CONNECT_CLIENT_ID=""
SIEMENS_HOME_CONNECT_CLIENT_SECRET=""
SIEMENS_HOME_CONNECT_ENV="prod" # prod (api.home-connect.com), simulator (simulator.home-connect.com) ou cn

# Configuration Somfy Cloud (Kit de connectivité / TaHoma via Overkiz, 100% lecture seule — optionnel)
SOMFY_EMAIL=""
SOMFY_PASSWORD=""
SOMFY_REGION="eu" # eu (Europe), na (Amérique du Nord) ou oc (Océanie)
# SOMFY_CLOUD_URL="" # Optionnel : surcharge l'URL Overkiz enduserAPI
# SOMFY_GATEWAY_IP="" # Optionnel : repli IP locale passerelle si Overkiz Cloud renvoie "N/A"
# SOMFY_GATEWAY_MAC="" # Optionnel : repli MAC passerelle (ex. AA:BB:CC:DD:EE:FF) si masquée par Overkiz

# Configuration Daikin Onecta Cloud (OAuth 2.0, 100% lecture seule — optionnel)
DAIKIN_CLIENT_ID=""
DAIKIN_CLIENT_SECRET=""
# DAIKIN_REDIRECT_URI="" # Optionnel : surcharge explicite (ex. https://votre-app.vercel.app/api/vendors/daikin/oauth/callback ou redirection HTTPS pour tests locaux)

# Configuration X-Sense Home Security (100% cloud, lecture seule — optionnel, compte invité/partagé recommandé)
XSENSE_EMAIL=""
XSENSE_PASSWORD=""

# Configuration Xiaomi Home / Mi Cloud (100% cloud, lecture seule — optionnel ; connexion QR Code aussi possible sans mot de passe dans l'interface)
XIAOMI_USERNAME=""
XIAOMI_PASSWORD=""
XIAOMI_REGION="de" # de (Europe, défaut), cn, us, sg, ru ou i2

# Alertes sortantes automatiques (optionnel — évaluées lors du cron /api/schedule/collect)
# ALERT_WEBHOOK_URL="" # Webhook JSON générique (POST)
# ALERT_WEBHOOK_SECRET="" # Optionnel : envoyé dans le header X-Home-Cockpit-Secret
# ALERT_TELEGRAM_BOT_TOKEN=""
# ALERT_TELEGRAM_CHAT_ID=""
# ALERT_DISCORD_WEBHOOK_URL=""
# ALERT_NTFY_URL="" # ex. https://ntfy.sh/mon-sujet
# ALERT_NTFY_TOKEN=""
# ALERT_COOLDOWN_MINUTES="180" # Délai anti-spam entre 2 alertes identiques (défaut 180 min)
# ALERT_LOW_BATTERY_PCT="15" # Seuil alerte pile faible (défaut 15 %)
# ALERT_POWER_PEAK_W="" # Optionnel : alerte si la puissance instantanée dépasse ce seuil (W)

# Rétention & compaction des séries temporelles (optionnel — exécuté 1x/24h sur le cron)
# METRICS_RAW_RETENTION_DAYS="90" # Agrège en 1 ligne/heure les données > 90 jours
# METRICS_DAILY_RETENTION_DAYS="730" # Supprime les données > 2 ans (0 = conserver indéfiniment)
