# Base de données Neon Postgres
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Sécurité de l'application
APP_PASSWORD="votre-mot-de-passe-dashboard"
SCHEDULE_SECRET="secret-long-aleatoire-pour-cron-job-org"

# Configuration Tuya IoT Cloud Platform
TUYA_ACCESS_ID="votre_access_id_tuya"
TUYA_ACCESS_SECRET="votre_access_secret_tuya"
TUYA_REGION="eu" # eu (Central Europe), weu (Western Europe), us, eus, cn, in
TUYA_USER_UID="votre_uid_compte_app_smart_life"

# Configuration Google Home Multi-Vendors (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_HOME_MODE="mcp" # "mcp" (Home MCP tous appareils) ou "sdm" (Nest SDM API)
GOOGLE_SDM_PROJECT_ID="" # Requis uniquement si GOOGLE_HOME_MODE="sdm"
TOKEN_ENCRYPTION_KEY="" # Optionnel : clé dédiée de chiffrement des tokens OAuth en BDD
